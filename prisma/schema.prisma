// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CUSTOMER
  ADMIN
  ARTISAN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  DIGITIZING
  STITCHING
  QUALITY_CHECK
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum EmbroideryType {
  TEXT
  ARTWORK
  HYBRID
}

enum StitchPlacement {
  CHEST_LEFT
  CHEST_CENTER
  SLEEVE_LEFT
  SLEEVE_RIGHT
  BACK_NAPE
  FULL_BACK
}

model User {
  id           String         @id @default(cuid())
  name         String
  email        String         @unique
  passwordHash String?
  role         Role           @default(CUSTOMER)
  phone        String?
  avatarUrl    String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  addresses    Address[]
  orders       Order[]
  wishlist     WishlistItem[]
  savedDesigns SavedDesign[]
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String   @default("Home") // Home, Studio, Work
  fullName   String
  phone      String
  street     String
  landmark   String?
  city       String
  state      String
  postalCode String
  country    String   @default("India")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  image       String?
  products    Product[]
  createdAt   DateTime  @default(now())
}

model Product {
  id             String           @id @default(cuid())
  name           String
  slug           String           @unique
  description    String
  story          String?
  basePrice      Float
  salePrice      Float?
  gsm            Int              @default(240) // 240 GSM Luxury Organic Cotton
  fabric         String           @default("100% Combed Pima Cotton")
  fit            String           @default("Boxy Oversized Atelier Fit")
  isCustomizable Boolean          @default(true)
  images         String[]         // Cloudinary/storage URLs or static asset paths
  categoryId     String?
  category       Category?        @relation(fields: [categoryId], references: [id])
  isFeatured     Boolean          @default(false)
  inStock        Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  variants       ProductVariant[]
  orderItems     OrderItem[]
  wishlistItems  WishlistItem[]
}

model ProductVariant {
  id         String      @id @default(cuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  size       String      // S, M, L, XL, XXL
  colorName  String      // Bone White, Vintage Onyx, Forest Sage, Terracotta, Sand Drift
  colorHex   String      // #FAF8F5, #222222, #556B2F, etc.
  sku        String      @unique
  stockCount Int         @default(50)
  orderItems OrderItem[]
}

model CustomEmbroidery {
  id                 String          @id @default(cuid())
  type               EmbroideryType  @default(TEXT)
  placement          StitchPlacement @default(CHEST_LEFT)
  customText         String?
  fontStyle          String?         // Script, Roman, Gothic, Modern
  threadColor        String?         // Gold, Silver, Emerald, Champagne, etc.
  threadColorHex     String?
  stitchType         String?         // Satin, Flat, 3D Puff
  uploadedImageUrl   String?
  artworkNotes       String?
  estimatedStitches  Int             @default(3500)
  digitizingFee      Float           @default(0)
  customCharge       Float           @default(299)
  mockupPreviewUrl   String?
  status             String          @default("SUBMITTED")
  createdAt          DateTime        @default(now())

  orderItem          OrderItem?
}

model Order {
  id              String         @id @default(cuid())
  orderNumber     String         @unique // e.g. GET-2026-9812
  userId          String?
  user            User?          @relation(fields: [userId], references: [id])
  guestEmail      String?
  guestName       String?
  guestPhone      String?

  subtotal        Float
  customizationFee Float         @default(0)
  shippingFee     Float          @default(0)
  discount        Float          @default(0)
  totalAmount     Float

  status          OrderStatus    @default(PENDING)
  paymentStatus   PaymentStatus  @default(PENDING)
  paymentGateway  String         @default("PAYU")

  // PayU specific details
  payuTxnId       String?        @unique
  payuMihpayId    String?
  payuMode        String?        // UPI, CC, DC, NB

  shippingAddress Json           // Full address snapshot
  trackingNumber  String?
  courierName     String?

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  items           OrderItem[]
  paymentLogs     PaymentLog[]
}

model OrderItem {
  id                 String            @id @default(cuid())
  orderId            String
  order              Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId          String
  product            Product           @relation(fields: [productId], references: [id])
  variantId          String?
  variant            ProductVariant?   @relation(fields: [variantId], references: [id])

  quantity           Int               @default(1)
  unitPrice          Float
  totalPrice         Float

  customEmbroideryId String?           @unique
  customEmbroidery   CustomEmbroidery? @relation(fields: [customEmbroideryId], references: [id])
}

model PaymentLog {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  txnId        String
  amount       Float
  status       String   // SUCCESS, FAILURE, PENDING
  rawResponse  Json?
  hashVerified Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model SavedDesign {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  teeColor       String
  teeSize        String
  placement      String
  customText     String?
  fontStyle      String?
  threadColor    String?
  uploadedImage  String?
  previewUrl     String?
  createdAt      DateTime @default(now())
}
